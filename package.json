{
  "name": "react-fabrio",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=playground --",
    "build": "turbo run build --",
    "build:packages": "turbo run build --filter='./packages/**' --",
    "typecheck": "turbo run typecheck && tsc -p tests/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build:packages && playwright test --config e2e/playwright.config.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "react-doctor": "react-doctor --project @react-fabrio/docs,playground,@react-fabrio/react,@react-fabrio/ui --yes --blocking error --no-telemetry",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "preview": "turbo run preview --filter=playground --",
    "prepare": "lefthook install",
    "docs:dev": "turbo run dev --filter=@react-fabrio/docs --",
    "docs:build": "turbo run build --filter=@react-fabrio/docs --",
    "docs:preview": "turbo run preview --filter=@react-fabrio/docs --",
    "docs:test": "turbo run test --filter=@react-fabrio/docs --",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react-doctor": "^0.9.18",
    "semantic-release": "^25.0.9",
    "turbo": "2.11.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": "12.14.x"
  },
  "packageManager": "pnpm@12.14.0"
}
