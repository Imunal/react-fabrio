{
  "name": "react-fabrio",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "react-doctor": "react-doctor --project playground,@react-fabrio/react,@react-fabrio/ui --yes --blocking error --no-telemetry",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "preview": "pnpm --filter playground preview",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react-doctor": "^0.9.18",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": "12.14.x"
  },
  "packageManager": "pnpm@12.14.0"
}
