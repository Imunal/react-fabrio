{
  "name": "@react-fabrio/ui",
  "version": "0.0.1",
  "license": "MIT",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-fabrio-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config ../../vite.library.config.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit --customConditions react-fabrio-source --rootDir ../..",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@react-fabrio/core": "workspace:*",
    "@react-fabrio/fabric": "workspace:*",
    "@react-fabrio/react": "workspace:*",
    "i18next": "^26.5.0",
    "react-aria-components": "^1.0.0",
    "react-i18next": "^17.1.0"
  },
  "devDependencies": {
    "@react-fabrio/three": "workspace:*",
    "@types/react": "^19.3.0",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "@react-fabrio/three": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@react-fabrio/three": {
      "optional": true
    }
  }
}
