{
  "name": "@react-fabrio/core",
  "version": "0.0.1",
  "description": "Framework-independent product types for react-fabrio.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-fabrio-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./examples": {
      "react-fabrio-source": "./src/examples.ts",
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-18",
    "svgpath": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
