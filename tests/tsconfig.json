{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@react-fabrio/core": ["../packages/core/src/index.ts"],
      "@react-fabrio/ui": ["../packages/ui/src/index.ts"],
